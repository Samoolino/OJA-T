# OJA-T Ubuntu development environment
# Copy to .env; never commit the real file.
RAILS_ENV=development
RACK_ENV=development
RAILS_LOG_TO_STDOUT=true

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=oja_t
POSTGRES_PASSWORD=change-me
POSTGRES_DB=oja_t_development
DATABASE_URL=postgresql://oja_t:change-me@127.0.0.1:5432/oja_t_development

REDIS_URL=redis://127.0.0.1:6379/1
PORT=3001
HOST=127.0.0.1

# Optional terminal/runtime profile.
HERMES_ENV=ubuntu
HERMES_COMMAND=hermes
